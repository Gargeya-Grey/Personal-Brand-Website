# Public site URL (callbacks, absolute OG links).
# Production example: https://sgargeya.com (cookie Domain is shared with www)
APP_URL="http://localhost:3000"

# Session signing (required in production)
JWT_SECRET="replace-with-long-random-string"

# Share auth cookie across apex + www (production). No quotes. Prefer:
# COOKIE_DOMAIN=sgargeya.com
# (leading dot optional; quotes will break the cookie)
COOKIE_DOMAIN=""

# Google OAuth (optional locally — use mock login when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAILS="you@example.com"

# AI metadata provider — default: meta (Muse Spark). Toggle to openrouter in the Editorial UI.
# AI_METADATA_PROVIDER=meta  # meta | openrouter

# Meta (Muse Spark) — default for blog metadata (/api/ai/fill)
MODEL_API_KEY=""
META_MODEL="muse-spark-1.2-contributor"

# OpenRouter — fallback/alternate for CMS AI fill + cover generation
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
# Cover images via OpenRouter (required for /api/ai/generate-cover — no code fallback)
IMAGE_GENERATION_MODEL="x-ai/grok-imagine-image-quality"

# Supabase — production blog + cover storage + X To-Do packs (recommended for deploy)
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Local Grok scout → hosted site (same secret on Vercel + local .env)
# Generate: openssl rand -hex 32
X_SCOUT_SECRET=""

# X Lab — growth analytics (user-context OAuth as @GargeyaS)
# Create app at https://developer.x.com — callback must match X_OAUTH_REDIRECT_URI
X_CLIENT_ID=""
X_CLIENT_SECRET=""
# Production example: https://sgargeya.com/api/x-lab/oauth/callback
# Local example: http://localhost:3000/api/x-lab/oauth/callback
X_OAUTH_REDIRECT_URI=""
# Long random secret used to AES-GCM encrypt OAuth tokens at rest (32+ chars)
X_TOKEN_ENCRYPTION_KEY=""
X_HANDLE="GargeyaS"

# Contact & newsletter (optional; mailto/local fallbacks exist)
CONTACT_EMAIL="gargeya.sharma@gmail.com"
RESEND_API_KEY=""
# After domain verify: brand From on your domain — not gmail.com
RESEND_FROM="Gargeya Sharma <sensei@sgargeya.com>"
# Segment ID from Resend → Audience → Segments (UUID). Alias: RESEND_AUDIENCE_ID
RESEND_SEGMENT_ID=""
RESEND_AUDIENCE_ID=""
CONTACT_WEBHOOK_URL=""
NEWSLETTER_WEBHOOK_URL=""
# Vercel Cron for Notes send waves (Sunday 19:00 local per subscriber timezone)
CRON_SECRET=""

# Community
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/your-invite"

# Finance Ledger (/ledger) — Notion + extraction
# Per-user Notion keys can also be saved in the UI (encrypted with X_TOKEN_ENCRYPTION_KEY).
NOTION_API_KEY=""
NOTION_DATABASE_ID=""

# Default extractor: Gemini (same as the old standalone app)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"
GEMINI_MODEL_FALLBACK="gemini-flash-latest"

# Optional OpenRouter path. Change LEDGER_OPENROUTER_MODEL and restart — no code edits.
# Falls back to OPENROUTER_MODEL if this is empty.
LEDGER_OPENROUTER_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"
