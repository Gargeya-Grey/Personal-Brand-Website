# Public site URL (callbacks, absolute OG links)
APP_URL="http://localhost:3000"

# Session signing (required in production)
JWT_SECRET="replace-with-long-random-string"

# Google OAuth (optional locally — use mock login when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
ALLOWED_EMAILS="you@example.com"

# OpenRouter — CMS AI fill + cover generation
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free"

# Supabase — production blog + cover storage + X To-Do packs (recommended for deploy)
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Local Grok scout → hosted site (same secret on Vercel + local .env)
# Generate: openssl rand -hex 32
X_SCOUT_SECRET=""

# Contact & newsletter (optional; mailto/local fallbacks exist)
CONTACT_EMAIL="gargeya.sharma@gmail.com"
RESEND_API_KEY=""
# After domain verify: brand From on your domain — not gmail.com
RESEND_FROM="Gargeya Sharma <sensei@sgargeya.com>"
# Segment ID from Resend → Audience → Segments (UUID). Alias: RESEND_AUDIENCE_ID
RESEND_SEGMENT_ID=""
RESEND_AUDIENCE_ID=""
CONTACT_WEBHOOK_URL=""
NEWSLETTER_WEBHOOK_URL=""

# Community
NEXT_PUBLIC_DISCORD_INVITE="https://discord.gg/your-invite"
